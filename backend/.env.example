# Copy this file to .env in the project root and fill in real values.
# Never commit the actual .env file.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumereviewerdv
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout — lock after N failures within the window
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=15

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6

# ── Server ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# "development" or "production" — enables HSTS header in production
ENV=development

# ── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Redis (job queue) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email ────────────────────────────────────────────────────────────────────
# Priority: SendGrid (if key set) → SMTP (if host set) → stdout (dev fallback)
#
# Option A — SendGrid (recommended for production)
# Sign up at sendgrid.com, verify your sender domain, then paste the key below.
# SMTP_FROM must match a verified sender identity in your SendGrid account.
SENDGRID_API_KEY=
#
# Option B — SMTP (any provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
#
# Shared
SMTP_FROM=noreply@resumereviewerdv.com
# Backend base URL — used in verification email links
APP_URL=http://localhost:8000
# Frontend base URL — used in results email links
FRONTEND_URL=http://localhost:3000

# ── Observability ────────────────────────────────────────────────────────────
# Leave unset to disable Sentry error tracking
SENTRY_DSN=

# ── Docker compose (only needed when running via docker-compose) ─────────────
POSTGRES_PASSWORD=changeme
POSTGRES_DB=resumereviewerdv
