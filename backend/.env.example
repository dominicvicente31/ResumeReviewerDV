# Copy this file to .env in the project root and fill in real values.
# Never commit the actual .env file.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumereviewerdv
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout — lock after N failures within the window
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=15

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6

# ── Server ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# "development" or "production" — enables HSTS header in production
ENV=development

# ── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Redis (job queue) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to log verification links to stdout instead of sending email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@resumereviewerdv.com
# Base URL used to build verification links — set to your public domain in production
APP_URL=http://localhost:8000

# ── Observability ────────────────────────────────────────────────────────────
# Leave unset to disable Sentry error tracking
SENTRY_DSN=

# ── Docker compose (only needed when running via docker-compose) ─────────────
POSTGRES_PASSWORD=changeme
POSTGRES_DB=resumereviewerdv
